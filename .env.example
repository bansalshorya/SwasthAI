# Server-only secrets. Never prefix an API key with VITE_ and never commit a real key.

# NVIDIA Build's hosted multimodal Chat Completions API.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=replace_with_your_nvidia_api_key
AI_MODEL=z-ai/glm-5.3-flash
AI_API_STYLE=chat-completions

# By default, report translation uses the same NVIDIA provider and key.
# Optional separate server-side key and quota for report translation:
# If any TRANSLATION_* setting is enabled, TRANSLATION_API_KEY is required.
# Omit all of these to use the NVIDIA screening provider for translation.
# TRANSLATION_PROVIDER=nvidia
# TRANSLATION_API_KEY=replace_with_your_translation_only_key
# TRANSLATION_MODEL=z-ai/glm-5.3-flash
# TRANSLATION_API_STYLE=chat-completions
# TRANSLATION_BASE_URL=https://integrate.api.nvidia.com/v1

# Server-side TinyFish Search key for the optional "Find care nearby" feature.
# Obtain a key from TinyFish and add it to .env or your deployment settings.
# TINYFISH_API_KEY=replace_with_your_tinyfish_api_key

# OpenAI alternative:
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace_with_your_openai_project_api_key
# AI_MODEL=gpt-6.1-sol
# AI_API_STYLE=responses
# AI_REASONING_EFFORT=low

# Groq alternative:
# AI_PROVIDER=groq
# GROQ_API_KEY=replace_with_your_groq_api_key
# AI_MODEL=qwen/qwen3.8-27b
# AI_API_STYLE=chat-completions

# Any other compatible multimodal provider:
# AI_PROVIDER=compatible
# AI_API_KEY=replace_with_your_provider_api_key
# AI_BASE_URL=https://provider.example/v1
# AI_MODEL=provider-model-id
# AI_API_STYLE=chat-completions

AI_SERVER_HOST=127.0.0.1
AI_SERVER_PORT=8787

# The browser calls the same-origin endpoint by default.
VITE_AI_PROXY_URL=/api/analyze

# Explicit presentation/offline mode only. Production should keep this false.
VITE_ENABLE_DEMO_AI=false
